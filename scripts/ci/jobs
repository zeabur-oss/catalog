# The CI jobs: scripts/ci.sh and zeabur-oss/.github README.md say what the settings mean.
# Text the code doesn't read: docs/, the change files and the top-level Markdown but README.md,
# which the release bundle packs.
*               runner=ubuntu-26.04 skip-if-only=docs/*,.changeset/*,CHANGELOG.md,CONTRIBUTING.md
# The short checks run one after another: each needs about a minute to set up a runner and its dev
# shell but much less to run.
lint
format          in=lint
scripts         in=lint
test
# Validate, render, template lint and a server-side dry run on a local API server.
check
release
