{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>zeabur-oss/.github"
  ],
  "gitIgnoredAuthors": [
    "349476329+zeabur-oss-bot[bot]@users.noreply.github.com"
  ],
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "Helm charts, with their chartDigest: an HTTP chart's is the digest in its repository's index.yaml, an OCI chart's the manifest digest",
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": [
        "/^components/.+\\.yaml$/"
      ],
      "matchStrings": [
        "releases[$contains(repo, 'https://')].{ 'depName': chart, 'registryUrl': repo, 'currentValue': version, 'currentDigest': $substringAfter(chartDigest, 'sha256:'), 'datasource': 'helm' }",
        "releases[$contains(chart, 'oci://')].{ 'depName': $substringAfter(chart, 'oci://'), 'currentValue': version, 'currentDigest': chartDigest, 'datasource': 'docker' }"
      ]
    },
    {
      "description": "Manifests from GitHub releases. Renovate cannot read their urlDigests: catalog render prints the new ones",
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/.+\\.yaml$/"
      ],
      "matchStrings": [
        "- https://github\\.com/(?<depName>[^/\\s]+/[^/\\s]+)/releases/download/\\{version\\}/\\S+\\n\\s+version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Traefik plugins pinned in contributed values",
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/.+\\.yaml$/"
      ],
      "matchStrings": [
        "moduleName: github\\.com/(?<depName>\\S+)\\n\\s+version: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "description": "Container images pinned inside values",
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/.+\\.yaml$/"
      ],
      "matchStrings": [
        "image: (?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>v?[0-9][^\\s\"@]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Container image tags pinned under a chart's image.repository",
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/.+\\.yaml$/"
      ],
      "matchStrings": [
        "repository: (?<depName>[a-z0-9][a-z0-9./_-]*)\\n(?:\\s*#.*\\n)*\\s+tag: [\"']?(?<currentValue>v?[0-9][^\\s\"'@]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Container images under a chart's image.repository, with image.registry on the line after it",
      "customType": "regex",
      "managerFilePatterns": [
        "/^components/.+\\.yaml$/"
      ],
      "matchStrings": [
        "repository: (?<depName>[a-z0-9][a-z0-9./_-]*)\\n\\s+registry: (?<registryUrl>[a-z0-9.-]+)\\n(?:\\s*#.*\\n)*\\s+tag: [\"']?(?<currentValue>v?[0-9][^\\s\"'@]*)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "registryUrlTemplate": "https://{{{registryUrl}}}",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Container images in template manifests",
      "customType": "regex",
      "managerFilePatterns": [
        "/^templates/[^/]+/manifests\\.yaml$/"
      ],
      "matchStrings": [
        "(?:image|imageName|initImage):\\s*[\"']?(?<depName>[a-z0-9][a-z0-9./_-]*):(?<currentValue>[a-zA-Z0-9._-]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "A template's metadata.version, the tag of the image named on the line above it; it moves in the same pull request as that image",
      "customType": "regex",
      "managerFilePatterns": [
        "/^templates/[^/]+/template\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+)\\n\\s+version: \"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    },
    {
      "description": "Cluster versions e2e runs on",
      "customType": "regex",
      "managerFilePatterns": [
        "/^config/kubernetes\\.yaml$/"
      ],
      "matchStrings": [
        "version: (?<currentValue>\\S+) # renovate: (?<datasource>\\S+) (?<depName>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "The kind node, k3s and RKE2 follow the Kubernetes minor that the Zeabur installer pins; a minor bump changes them together",
      "matchPackageNames": [
        "kindest/node",
        "k3s-io/k3s",
        "rancher/rke2"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ],
      "enabled": false
    },
    {
      "description": "k3s and RKE2 tags are <Kubernetes version>+k3s<n> and +rke2r<n>",
      "matchPackageNames": [
        "k3s-io/k3s",
        "rancher/rke2"
      ],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+(k3s|rke2r)(?<build>\\d+)$"
    },
    {
      "description": "go.sum changes the vendorHash in flake.nix; the vendorhash workflow commits the new one as zeabur-oss-bot.",
      "matchManagers": [
        "gomod"
      ],
      "postUpdateOptions": [
        "gomodTidy"
      ]
    },
    {
      "description": "Each component file gets its own pull request, with its chart and images together, so CI tests one component at a time. Every image carries a digest",
      "matchFileNames": [
        "components/**"
      ],
      "groupName": "{{{packageFile}}}",
      "pinDigests": true
    },
    {
      "description": "Pre-1.0 upstreams change behaviour in minor releases; never automerge them",
      "matchFileNames": [
        "components/**"
      ],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "Manifests and Traefik plugins from GitHub releases carry a version; urlDigests holds the digest of a manifest",
      "matchFileNames": [
        "components/**"
      ],
      "matchDatasources": [
        "github-releases"
      ],
      "pinDigests": false
    },
    {
      "description": "The Gateway API CRDs follow the gateway-api version in the go.mod of the Traefik release that the chart runs; move them by hand with Traefik",
      "matchPackageNames": [
        "kubernetes-sigs/gateway-api"
      ],
      "enabled": false
    },
    {
      "description": "Each template gets its own pull request, with its images and metadata.version together, and a person reviews every image change",
      "matchFileNames": [
        "templates/**"
      ],
      "groupName": "{{{packageFileDir}}}",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "metadata.version is a tag alone; its digest is on the image in manifests.yaml",
      "matchFileNames": [
        "templates/*/template.yaml"
      ],
      "pinDigests": false
    },
    {
      "description": "Keel's smoke test starts on pause 3.9 so that Keel can update it to 3.10",
      "matchFileNames": [
        "components/keel.yaml"
      ],
      "matchPackageNames": [
        "registry.k8s.io/pause"
      ],
      "enabled": false
    },
    {
      "description": "Database images change their data format in a major release; a person approves each major upgrade",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^(docker\\.io/)?(library/)?(mariadb|mysql)$/",
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/cybozu-go/moco/mysql"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true
    },
    {
      "description": "The Percona operator supports only the MongoDB and PBM versions in its version service (check.percona.com/versions/v1/psmdb-operator/<operator version>); move them by hand when the operator moves",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^(docker\\.io/)?percona/percona-server-mongodb$/",
        "/^(docker\\.io/)?percona/percona-backup-mongodb$/"
      ],
      "enabled": false
    },
    {
      "description": "Ghost supports MySQL 8 only; later MySQL tags such as 26.10 are innovation releases",
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        "templates/ghost/**"
      ],
      "matchPackageNames": [
        "/^(docker\\.io/)?(library/)?mysql$/"
      ],
      "allowedVersions": "/^8\\./"
    },
    {
      "description": "SearXNG tags are <year>.<month>.<day>-<commit>",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^(docker\\.io/)?searxng/searxng$/"
      ],
      "versioning": "regex:^(?<major>\\d{4})\\.(?<minor>\\d{1,2})\\.(?<patch>\\d{1,2})-[0-9a-f]+$"
    },
    {
      "description": "MariaDB LTS series only (12.3 today); other series such as 13 are rolling releases with a short support window. Move to the next LTS by hand",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "/^(docker\\.io/)?(library/)?mariadb$/"
      ],
      "allowedVersions": "/^12\\.3\\./"
    }
  ]
}
