{
  "$defs": {
    "Addon": {
      "additionalProperties": false,
      "description": "An add-on of a distribution.",
      "properties": {
        "distribution": {
          "$ref": "#/$defs/Distribution",
          "description": "The distribution."
        },
        "name": {
          "description": "The name of its `HelmChart` in `kube-system`.",
          "type": "string"
        }
      },
      "required": [
        "distribution",
        "name"
      ],
      "type": "object"
    },
    "ApiVersion": {
      "description": "The `apiVersion` of every component and template file.",
      "oneOf": [
        {
          "const": "catalog.zeabur.com/v1",
          "description": "`catalog.zeabur.com/v1`.",
          "type": "string"
        }
      ]
    },
    "ComponentKind": {
      "description": "The `kind` of a component file.",
      "oneOf": [
        {
          "const": "Component",
          "description": "`Component`.",
          "type": "string"
        }
      ]
    },
    "Contribution": {
      "additionalProperties": false,
      "description": "Values a component adds to a release of another component.",
      "properties": {
        "target": {
          "$ref": "#/$defs/ReleaseRef",
          "description": "The release that receives them."
        },
        "values": {
          "description": "Helm values, as YAML.",
          "type": "string"
        }
      },
      "required": [
        "target",
        "values"
      ],
      "type": "object"
    },
    "DetectedWorkload": {
      "additionalProperties": false,
      "description": "A workload whose labels show the upstream.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/WorkloadKind",
          "description": "Its kind."
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Labels that must all be there with these values.",
          "type": "object"
        }
      },
      "required": [
        "kind",
        "labels"
      ],
      "type": "object"
    },
    "Detection": {
      "additionalProperties": false,
      "description": "How to recognise an existing installation. Any one match means it is there.",
      "minProperties": 1,
      "properties": {
        "addons": {
          "default": [],
          "description": "Add-ons of a distribution that install the same upstream.",
          "items": {
            "$ref": "#/$defs/Addon"
          },
          "type": "array"
        },
        "apiServices": {
          "default": [],
          "description": "`APIService` names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "crds": {
          "default": [],
          "description": "`CustomResourceDefinition` names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "csiDrivers": {
          "default": [],
          "description": "CSI drivers of the `PersistentVolumes` it provides.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gatewayControllers": {
          "default": [],
          "description": "`GatewayClass` controller names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "helmCharts": {
          "default": [],
          "description": "Helm chart names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ingressControllers": {
          "default": [],
          "description": "`IngressClass` controller names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workloads": {
          "default": [],
          "description": "Workloads whose labels show the upstream.",
          "items": {
            "$ref": "#/$defs/DetectedWorkload"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Distribution": {
      "description": "A host distribution of Kubernetes that a component runs on.",
      "oneOf": [
        {
          "const": "k3s",
          "description": "K3s.",
          "type": "string"
        },
        {
          "const": "rke2",
          "description": "RKE2.",
          "type": "string"
        },
        {
          "const": "kubesolo",
          "description": "KubeSolo.",
          "type": "string"
        }
      ]
    },
    "Encoding": {
      "description": "How random bytes are written.",
      "oneOf": [
        {
          "const": "hex",
          "description": "Lowercase hexadecimal.",
          "type": "string"
        },
        {
          "const": "base64url",
          "description": "base64url without padding.",
          "type": "string"
        }
      ]
    },
    "Generate": {
      "description": "How an installer makes a value instead of asking for it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`bytes` random bytes in `encoding`.",
          "properties": {
            "bytes": {
              "description": "How many, 12 to 64.",
              "format": "uint8",
              "maximum": 64,
              "minimum": 12,
              "type": "integer"
            },
            "encoding": {
              "$ref": "#/$defs/Encoding",
              "description": "How they are written."
            },
            "type": {
              "const": "random",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bytes",
            "encoding"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A free address in the cluster's Service CIDR, for a Service's fixed `ClusterIP`.",
          "properties": {
            "type": {
              "const": "clusterIP",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Health": {
      "additionalProperties": false,
      "description": "A read-only check of an installed component: one `kubectl wait` or `kubectl rollout status`.",
      "else": {
        "required": [
          "condition"
        ]
      },
      "if": {
        "properties": {
          "resource": {
            "properties": {
              "kind": {
                "enum": [
                  "DaemonSet",
                  "Deployment",
                  "StatefulSet"
                ]
              }
            }
          }
        }
      },
      "properties": {
        "advice": {
          "description": "What to do when the check fails, in English.",
          "minLength": 1,
          "type": "string"
        },
        "condition": {
          "default": null,
          "description": "The condition the objects reach. A workload kind has none: it is ready when its rollout\nis complete.",
          "pattern": "^[A-Za-z]+$",
          "type": "string"
        },
        "name": {
          "description": "Its name.",
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "resource": {
          "$ref": "#/$defs/HealthResource",
          "description": "The objects to wait for."
        },
        "timeout": {
          "description": "How long to wait, such as `60s`.",
          "pattern": "^[1-9][0-9]*(s|m)$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "resource",
        "timeout",
        "advice"
      ],
      "then": {
        "not": {
          "required": [
            "condition"
          ]
        },
        "properties": {
          "resource": {
            "not": {
              "required": [
                "all"
              ]
            }
          }
        }
      },
      "type": "object"
    },
    "HealthKind": {
      "description": "A kind that a health check can wait for.",
      "oneOf": [
        {
          "const": "APIService",
          "description": "`APIService`.",
          "type": "string"
        },
        {
          "const": "DaemonSet",
          "description": "`DaemonSet`.",
          "type": "string"
        },
        {
          "const": "Deployment",
          "description": "`Deployment`.",
          "type": "string"
        },
        {
          "const": "GatewayClass",
          "description": "`GatewayClass`.",
          "type": "string"
        },
        {
          "const": "Node.longhorn.io",
          "description": "Longhorn's `Node`.",
          "type": "string"
        },
        {
          "const": "Pod",
          "description": "`Pod`.",
          "type": "string"
        },
        {
          "const": "StatefulSet",
          "description": "`StatefulSet`.",
          "type": "string"
        }
      ]
    },
    "HealthResource": {
      "additionalProperties": false,
      "description": "The objects of one kind a health check waits for: by `name`, by `selector`, or `all`.",
      "else": {
        "not": {
          "required": [
            "namespace"
          ]
        }
      },
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "DaemonSet",
              "Deployment",
              "Node.longhorn.io",
              "Pod",
              "StatefulSet"
            ]
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "selector"
          ]
        },
        {
          "required": [
            "all"
          ]
        }
      ],
      "properties": {
        "all": {
          "const": true,
          "default": false,
          "description": "Every object of the kind.",
          "type": "boolean"
        },
        "kind": {
          "$ref": "#/$defs/HealthKind",
          "description": "Their kind."
        },
        "name": {
          "default": null,
          "description": "The name of one object.",
          "minLength": 1,
          "type": "string"
        },
        "namespace": {
          "default": null,
          "description": "Their namespace, for a namespaced kind.",
          "minLength": 1,
          "type": "string"
        },
        "selector": {
          "additionalProperties": {
            "type": "string"
          },
          "default": null,
          "description": "The labels of the objects.",
          "minProperties": 1,
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "then": {
        "required": [
          "namespace"
        ]
      },
      "type": "object"
    },
    "Input": {
      "additionalProperties": false,
      "description": "A value an installer asks for or generates.",
      "oneOf": [
        {
          "required": [
            "path"
          ]
        },
        {
          "required": [
            "secret"
          ]
        }
      ],
      "properties": {
        "default": {
          "$ref": "#/$defs/InputValue",
          "default": null,
          "description": "The value when none is given."
        },
        "description": {
          "description": "What it is, in English.",
          "type": "string"
        },
        "generate": {
          "$ref": "#/$defs/Generate",
          "default": null,
          "description": "How an installer makes it when it is not given."
        },
        "name": {
          "description": "Its name, camelCase.",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "type": "string"
        },
        "path": {
          "default": null,
          "description": "Where it goes in the release's values: a dotted path, where a number indexes a list.",
          "type": "string"
        },
        "release": {
          "default": null,
          "description": "The release whose values take a `path` input; the first chart release when absent.",
          "type": "string"
        },
        "required": {
          "default": false,
          "description": "An install needs a value.",
          "type": "boolean"
        },
        "secret": {
          "$ref": "#/$defs/SecretRef",
          "default": null,
          "description": "The Secret key it is stored in, created before install."
        },
        "testValue": {
          "$ref": "#/$defs/InputValue",
          "default": null,
          "description": "The value CI installs with."
        }
      },
      "required": [
        "name",
        "description"
      ],
      "type": "object"
    },
    "InputValue": {
      "anyOf": [
        {
          "description": "`true` or `false`.",
          "type": "boolean"
        },
        {
          "description": "A whole number.",
          "format": "int64",
          "type": "integer"
        },
        {
          "description": "Text.",
          "type": "string"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/InputValue"
          },
          "description": "Values by key, set at a `path` as one object, such as a chart value that is a map.",
          "type": "object"
        }
      ],
      "description": "The value of an input."
    },
    "Metadata": {
      "additionalProperties": false,
      "description": "A component's name and summary.",
      "properties": {
        "homepage": {
          "description": "The project's home page.",
          "format": "uri",
          "type": "string"
        },
        "license": {
          "description": "An SPDX expression.",
          "type": "string"
        },
        "licenseUrls": {
          "additionalProperties": {
            "format": "uri",
            "pattern": "^https://",
            "type": "string"
          },
          "description": "The URL of the text of each `LicenseRef-` licence in `license`, by its id.",
          "propertyNames": {
            "pattern": "^LicenseRef-[A-Za-z0-9.-]+$",
            "type": "string"
          },
          "type": "object"
        },
        "locales": {
          "additionalProperties": {
            "$ref": "#/$defs/Summary"
          },
          "description": "The summary in other languages.",
          "propertyNames": {
            "pattern": "^([a-z]{2,3}(-[a-z]{3}){0,3}|[a-z]{4,8})(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?(-([a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(-[a-wyz0-9](-[a-z0-9]{2,8})+)*(-x(-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "description": "The name for people.",
          "type": "string"
        },
        "summary": {
          "description": "What it gives the cluster, in one plain sentence.",
          "pattern": "^[^\\n]+$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "summary",
        "locales",
        "license",
        "homepage"
      ],
      "type": "object"
    },
    "Mode": {
      "description": "Whether a profile installs a component by default.",
      "oneOf": [
        {
          "const": "recommended",
          "description": "On by default.",
          "type": "string"
        },
        {
          "const": "optional",
          "description": "Off by default.",
          "type": "string"
        },
        {
          "const": "unsupported",
          "description": "Not installed on the profile.",
          "type": "string"
        }
      ]
    },
    "PerProfile": {
      "additionalProperties": false,
      "description": "A value for each profile.",
      "properties": {
        "multi-node": {
          "$ref": "#/$defs/Mode",
          "description": "On `multi-node`."
        },
        "single-node": {
          "$ref": "#/$defs/Mode",
          "description": "On `single-node`."
        }
      },
      "required": [
        "single-node",
        "multi-node"
      ],
      "type": "object"
    },
    "PodSecurity": {
      "description": "A Pod Security Standard level.",
      "oneOf": [
        {
          "const": "restricted",
          "description": "`restricted`.",
          "type": "string"
        },
        {
          "const": "baseline",
          "description": "`baseline`.",
          "type": "string"
        },
        {
          "const": "privileged",
          "description": "`privileged`.",
          "type": "string"
        }
      ]
    },
    "ProfileValues": {
      "additionalProperties": false,
      "description": "Values for some profiles, as YAML.",
      "properties": {
        "multi-node": {
          "default": null,
          "description": "On `multi-node`.",
          "type": "string"
        },
        "single-node": {
          "default": null,
          "description": "On `single-node`.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Provides": {
      "additionalProperties": false,
      "description": "What a component offers other software in the cluster.",
      "minProperties": 1,
      "properties": {
        "capability": {
          "default": null,
          "description": "The capability it offers, such as `logs`.",
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "registry": {
          "$ref": "#/$defs/Registry",
          "default": null,
          "description": "An OCI registry in the cluster that nodes pull from."
        }
      },
      "type": "object"
    },
    "Quantities": {
      "additionalProperties": false,
      "description": "Kubernetes quantities by resource name.",
      "minProperties": 1,
      "properties": {
        "cpu": {
          "default": null,
          "description": "CPU, such as `100m`.",
          "minLength": 1,
          "type": "string"
        },
        "memory": {
          "default": null,
          "description": "Memory, such as `256Mi`.",
          "minLength": 1,
          "type": "string"
        }
      },
      "type": "object"
    },
    "Reference": {
      "description": "A component by id, or a capability: one component that provides it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`{component: <id>}`.",
          "properties": {
            "component": {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "component"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`{capability: <name>}`.",
          "properties": {
            "capability": {
              "pattern": "^[a-z0-9-]+$",
              "type": "string"
            }
          },
          "required": [
            "capability"
          ],
          "type": "object"
        }
      ]
    },
    "Registry": {
      "additionalProperties": false,
      "description": "An OCI registry in the cluster that nodes pull from.",
      "properties": {
        "ca": {
          "$ref": "#/$defs/SecretRef",
          "description": "The CA that signs its serving certificate."
        },
        "host": {
          "description": "The `host:port` that images name.",
          "pattern": "^[a-z0-9.-]+:[0-9]+$",
          "type": "string"
        }
      },
      "required": [
        "host",
        "ca"
      ],
      "type": "object"
    },
    "Release": {
      "description": "One install step of a component, by its `type`.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A Helm chart.",
          "properties": {
            "chart": {
              "description": "`oci://registry/path/chart`, or a chart name in `repo`.",
              "type": "string"
            },
            "chartDigest": {
              "description": "The OCI manifest digest, or the SHA-256 of the chart archive.",
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            },
            "name": {
              "description": "Its name in the file.",
              "pattern": "^[a-z0-9-]+$",
              "type": "string"
            },
            "namespace": {
              "description": "The namespace it installs into.",
              "type": "string"
            },
            "profiles": {
              "$ref": "#/$defs/ProfileValues",
              "default": {
                "multi-node": null,
                "single-node": null
              },
              "description": "Values merged over `values` on each profile, as YAML."
            },
            "releaseName": {
              "default": null,
              "description": "The Helm release name, when it is not `name`.",
              "type": "string"
            },
            "repo": {
              "default": null,
              "description": "The HTTP chart repository.",
              "pattern": "^https://",
              "type": "string"
            },
            "skipIfPresent": {
              "default": [],
              "description": "Skip it when these CRDs exist.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "helm",
              "type": "string"
            },
            "unpinnedImages": {
              "default": [],
              "description": "Images, without tag, that the chart cannot pin by digest.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "values": {
              "default": null,
              "description": "Values for every profile, as YAML.",
              "type": "string"
            },
            "version": {
              "description": "The chart version.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "namespace",
            "chart",
            "version",
            "chartDigest"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Files downloaded from URLs.",
          "properties": {
            "name": {
              "description": "Its name in the file.",
              "pattern": "^[a-z0-9-]+$",
              "type": "string"
            },
            "namespace": {
              "description": "The namespace it installs into.",
              "type": "string"
            },
            "skipIfPresent": {
              "default": [],
              "description": "Skip it when these CRDs exist.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "manifest",
              "type": "string"
            },
            "urlDigests": {
              "description": "The `sha256:<hex>` digest of each file, in the order of `urls`.",
              "items": {
                "pattern": "^sha256:[a-f0-9]{64}$",
                "type": "string"
              },
              "type": "array"
            },
            "urls": {
              "description": "The URLs, with `{version}` for `version`.",
              "items": {
                "pattern": "\\{version\\}",
                "type": "string"
              },
              "type": "array"
            },
            "version": {
              "description": "The version.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "namespace",
            "urls",
            "version",
            "urlDigests"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Objects written in the file.",
          "properties": {
            "manifests": {
              "description": "The objects, as YAML.",
              "type": "string"
            },
            "name": {
              "description": "Its name in the file.",
              "pattern": "^[a-z0-9-]+$",
              "type": "string"
            },
            "namespace": {
              "description": "The namespace it installs into.",
              "type": "string"
            },
            "skipIfPresent": {
              "default": [],
              "description": "Skip it when these CRDs exist.",
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": {
              "const": "inline",
              "type": "string"
            }
          },
          "required": [
            "type",
            "name",
            "namespace",
            "manifests"
          ],
          "type": "object"
        }
      ]
    },
    "ReleaseRef": {
      "additionalProperties": false,
      "description": "A release of a component.",
      "properties": {
        "component": {
          "description": "The component's id.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "release": {
          "description": "The release's name in its file.",
          "type": "string"
        }
      },
      "required": [
        "component",
        "release"
      ],
      "type": "object"
    },
    "Resources": {
      "additionalProperties": false,
      "description": "What a component needs beyond its measured idle use.",
      "properties": {
        "work": {
          "description": "Each kind of work it does, such as a build.",
          "items": {
            "$ref": "#/$defs/Work"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "work"
      ],
      "type": "object"
    },
    "SecretRef": {
      "additionalProperties": false,
      "description": "A key of a Secret.",
      "properties": {
        "key": {
          "description": "The key.",
          "type": "string"
        },
        "name": {
          "description": "The Secret's name.",
          "type": "string"
        },
        "namespace": {
          "description": "The Secret's namespace.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "key",
        "namespace"
      ],
      "type": "object"
    },
    "Security": {
      "additionalProperties": false,
      "description": "What a component's RBAC lets it do and what its namespaces must allow.",
      "properties": {
        "podSecurity": {
          "$ref": "#/$defs/PodSecurity",
          "description": "The level its namespaces need."
        },
        "summary": {
          "description": "What its RBAC lets it do.",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "podSecurity"
      ],
      "type": "object"
    },
    "Smoke": {
      "additionalProperties": false,
      "description": "An e2e check after install.",
      "properties": {
        "manifest": {
          "default": null,
          "description": "Objects to apply first, in the namespace `catalog-smoke`.",
          "type": "string"
        },
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "timeout": {
          "default": null,
          "description": "How long to wait; 180 seconds when absent.",
          "pattern": "^[1-9][0-9]*(s|m)$",
          "type": "string"
        },
        "wait": {
          "description": "What to wait for after the objects are applied.",
          "items": {
            "$ref": "#/$defs/Wait"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "wait"
      ],
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "A name and a summary in English, with the summary in other languages.",
      "properties": {
        "summary": {
          "description": "One line.",
          "pattern": "^[^\\n]+$",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "type": "object"
    },
    "Wait": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "required": [
              "condition"
            ]
          },
          "if": {
            "properties": {
              "resource": {
                "pattern": "^([Dd]aemon[Ss]et|[Dd]eployment|[Ss]tateful[Ss]et)(/|$)"
              }
            }
          },
          "then": {
            "properties": {
              "condition": {
                "pattern": "^jsonpath="
              }
            }
          }
        }
      ],
      "description": "One `kubectl wait` of a smoke check.",
      "else": {
        "oneOf": [
          {
            "required": [
              "selector"
            ]
          },
          {
            "required": [
              "all"
            ]
          }
        ]
      },
      "if": {
        "properties": {
          "resource": {
            "pattern": "/"
          }
        }
      },
      "properties": {
        "all": {
          "const": true,
          "default": false,
          "description": "Every object of the kind.",
          "type": "boolean"
        },
        "condition": {
          "default": null,
          "description": "What the objects reach, as a `kubectl wait --for` value.",
          "pattern": "^(condition=[A-Za-z][A-Za-z0-9]*(=(True|False|Unknown))?|jsonpath=.+)$",
          "type": "string"
        },
        "namespace": {
          "default": null,
          "description": "The namespace of the objects.",
          "minLength": 1,
          "type": "string"
        },
        "resource": {
          "description": "One object as `kind/name`, or a kind alone with a selector or `all`.",
          "pattern": "^[A-Za-z][A-Za-z0-9.]*(/[a-z0-9][a-z0-9.-]*)?$",
          "type": "string"
        },
        "selector": {
          "additionalProperties": {
            "type": "string"
          },
          "default": null,
          "description": "The labels of the objects.",
          "minProperties": 1,
          "type": "object"
        }
      },
      "required": [
        "resource"
      ],
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "selector"
              ]
            },
            {
              "required": [
                "all"
              ]
            }
          ]
        }
      },
      "type": "object"
    },
    "Work": {
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "requests"
          ]
        },
        {
          "required": [
            "limits"
          ]
        },
        {
          "required": [
            "use"
          ]
        }
      ],
      "description": "One kind of work a component does.",
      "properties": {
        "limits": {
          "$ref": "#/$defs/Quantities",
          "default": null,
          "description": "The limits of each pod doing one unit of work."
        },
        "name": {
          "description": "Its name.",
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "requests": {
          "$ref": "#/$defs/Quantities",
          "default": null,
          "description": "The requests of each pod doing one unit of work."
        },
        "use": {
          "$ref": "#/$defs/Quantities",
          "default": null,
          "description": "What one unit of work uses on top of the idle use."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "WorkloadKind": {
      "description": "A workload kind that the catalog recognises by its labels or its rollout.",
      "oneOf": [
        {
          "const": "DaemonSet",
          "description": "`DaemonSet`.",
          "type": "string"
        },
        {
          "const": "Deployment",
          "description": "`Deployment`.",
          "type": "string"
        },
        {
          "const": "StatefulSet",
          "description": "`StatefulSet`.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://oss-catalog.zeabur.com/v1/schema/component.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One upstream project that a cluster administrator installs.",
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/ApiVersion",
      "description": "`catalog.zeabur.com/v1`."
    },
    "contributes": {
      "default": [],
      "description": "Values it adds to releases of other components.",
      "items": {
        "$ref": "#/$defs/Contribution"
      },
      "type": "array"
    },
    "defaults": {
      "$ref": "#/$defs/PerProfile",
      "description": "Whether each profile installs it by default."
    },
    "detection": {
      "$ref": "#/$defs/Detection",
      "description": "How to recognise an existing installation."
    },
    "distributions": {
      "description": "The distributions it runs on and e2e tests it on.",
      "items": {
        "$ref": "#/$defs/Distribution"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "health": {
      "default": [],
      "description": "Read-only checks of an installed component.",
      "items": {
        "$ref": "#/$defs/Health"
      },
      "type": "array"
    },
    "inputs": {
      "default": [],
      "description": "Values an installer asks for or generates.",
      "items": {
        "$ref": "#/$defs/Input"
      },
      "type": "array"
    },
    "internalCRDs": {
      "default": [],
      "description": "The CRDs of `detection.crds` whose objects it writes itself, so they do not mean anyone\nuses it.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/ComponentKind",
      "description": "`Component`."
    },
    "kubeVersion": {
      "description": "The Kubernetes versions it supports, as a `SemVer` range like Helm's `kubeVersion`.",
      "minLength": 1,
      "type": "string"
    },
    "leftovers": {
      "default": [],
      "description": "What the upstream keeps on uninstall.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata",
      "description": "Its name and summary."
    },
    "networkPolicies": {
      "default": null,
      "description": "`NetworkPolicy` objects for its namespaces, applied before the releases.",
      "type": "string"
    },
    "persistsData": {
      "default": false,
      "description": "It keeps state in volumes, so uninstalling it loses data.",
      "type": "boolean"
    },
    "provides": {
      "$ref": "#/$defs/Provides",
      "default": null,
      "description": "What it offers other software in the cluster."
    },
    "releases": {
      "description": "What it installs, in order.",
      "items": {
        "$ref": "#/$defs/Release"
      },
      "minItems": 1,
      "type": "array"
    },
    "requires": {
      "default": [],
      "description": "The components installed before it.",
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array",
      "uniqueItems": true
    },
    "resources": {
      "$ref": "#/$defs/Resources",
      "default": null,
      "description": "What it needs beyond its measured idle use."
    },
    "security": {
      "$ref": "#/$defs/Security",
      "description": "What its RBAC lets it do and what its namespaces must allow."
    },
    "smoke": {
      "default": [],
      "description": "Extra e2e checks after install.",
      "items": {
        "$ref": "#/$defs/Smoke"
      },
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "defaults",
    "distributions",
    "kubeVersion",
    "releases",
    "detection",
    "security"
  ],
  "title": "Component",
  "type": "object"
}
