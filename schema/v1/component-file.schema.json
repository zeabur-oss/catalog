{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oss-catalog.zeabur.com/v1/schema/component-file.schema.json",
  "title": "components/<id>.json",
  "description": "`components/<id>.json`.",
  "$defs": {
    "Distribution": {
      "description": "A host distribution of Kubernetes that a component runs on.",
      "oneOf": [
        {
          "const": "k3s",
          "description": "K3s.",
          "type": "string"
        },
        {
          "const": "rke2",
          "description": "RKE2.",
          "type": "string"
        },
        {
          "const": "kubesolo",
          "description": "KubeSolo.",
          "type": "string"
        }
      ]
    },
    "Environment": {
      "additionalProperties": false,
      "description": "One run of an e2e test.",
      "properties": {
        "addOns": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The pinned release of each add-on it installed on the host, by name.",
          "type": "object"
        },
        "dependencies": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "The digest of each component it installed first, by id.",
          "type": "object"
        },
        "distribution": {
          "$ref": "#/$defs/MeasuredDistribution",
          "description": "Where it ran."
        },
        "distributionVersion": {
          "description": "The release of a host distribution; kind has none.",
          "type": "string"
        },
        "kubernetesVersion": {
          "description": "Absent when the cluster never answered.",
          "type": "string"
        },
        "measuredAt": {
          "description": "The day, `YYYY-MM-DD` in UTC.",
          "format": "date",
          "type": "string"
        },
        "platform": {
          "$ref": "#/$defs/Platform",
          "description": "The platform of the nodes."
        },
        "pods": {
          "description": "The idle use of one pod of each workload it started.",
          "items": {
            "$ref": "#/$defs/PodUsage"
          },
          "type": "array"
        },
        "profile": {
          "$ref": "#/$defs/Profile",
          "description": "The profile whose values it installed."
        },
        "result": {
          "$ref": "#/$defs/RunResult",
          "description": "Whether it passed."
        },
        "sourceDigest": {
          "description": "The digest of the directory it installed.",
          "type": "string"
        },
        "versions": {
          "description": "The version of each release or image it installed.",
          "items": {
            "$ref": "#/$defs/MeasuredVersion"
          },
          "type": "array"
        }
      },
      "required": [
        "distribution",
        "profile",
        "platform",
        "result",
        "measuredAt"
      ],
      "type": "object"
    },
    "Kind": {
      "description": "kind, Kubernetes in Docker.",
      "oneOf": [
        {
          "const": "kind",
          "description": "`kind`.",
          "type": "string"
        }
      ]
    },
    "MeasuredDistribution": {
      "anyOf": [
        {
          "$ref": "#/$defs/Kind",
          "description": "kind."
        },
        {
          "$ref": "#/$defs/Distribution",
          "description": "A distribution installed on the host."
        }
      ],
      "description": "Where an e2e run ran: kind, or a host distribution."
    },
    "MeasuredVersion": {
      "additionalProperties": false,
      "description": "The version of a component's release or of a template's image.",
      "properties": {
        "digest": {
          "description": "The digest.",
          "type": "string"
        },
        "image": {
          "description": "The image.",
          "type": "string"
        },
        "release": {
          "description": "The release.",
          "type": "string"
        },
        "version": {
          "description": "The version.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Platform": {
      "additionalProperties": false,
      "description": "An OS and an architecture.",
      "properties": {
        "architecture": {
          "description": "`amd64`.",
          "type": "string"
        },
        "os": {
          "description": "`linux`.",
          "type": "string"
        }
      },
      "required": [
        "os",
        "architecture"
      ],
      "type": "object"
    },
    "PodUsage": {
      "additionalProperties": false,
      "description": "The idle use of one pod of a workload.",
      "properties": {
        "cpu": {
          "description": "CPU, such as `3m`.",
          "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(([KMGTPE]i)|[numkMGTPE]|([eE][+-]?[0-9]+))?$",
          "type": "string"
        },
        "kind": {
          "description": "The controller's kind.",
          "type": "string"
        },
        "memory": {
          "description": "Memory, such as `22Mi`.",
          "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(([KMGTPE]i)|[numkMGTPE]|([eE][+-]?[0-9]+))?$",
          "type": "string"
        },
        "workload": {
          "description": "The controller the pod belongs to.",
          "type": "string"
        }
      },
      "required": [
        "workload",
        "kind",
        "memory",
        "cpu"
      ],
      "type": "object"
    },
    "Profile": {
      "description": "A deployment layout. Every component describes both.",
      "oneOf": [
        {
          "const": "single-node",
          "description": "One node.",
          "type": "string"
        },
        {
          "const": "multi-node",
          "description": "Three nodes or more.",
          "type": "string"
        }
      ]
    },
    "Render": {
      "additionalProperties": false,
      "description": "What `helm template` renders for each profile with the test inputs and every contribution.",
      "properties": {
        "kubernetesVersion": {
          "description": "The Kubernetes version of the render.",
          "type": "string"
        },
        "profiles": {
          "additionalProperties": {
            "$ref": "#/$defs/RenderedProfile"
          },
          "description": "The objects of each profile. A profile where the component is unsupported is missing.",
          "type": "object"
        }
      },
      "required": [
        "kubernetesVersion",
        "profiles"
      ],
      "type": "object"
    },
    "RenderedClaim": {
      "additionalProperties": false,
      "description": "The requested storage of a `PersistentVolumeClaim`.",
      "properties": {
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "namespace": {
          "description": "Its namespace; a `volumeClaimTemplates` entry has none.",
          "type": "string"
        },
        "release": {
          "description": "The release that renders it; a `volumeClaimTemplates` entry has none.",
          "type": "string"
        },
        "storage": {
          "description": "The storage it requests.",
          "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(([KMGTPE]i)|[numkMGTPE]|([eE][+-]?[0-9]+))?$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "storage"
      ],
      "type": "object"
    },
    "RenderedContainer": {
      "additionalProperties": false,
      "description": "The requests and limits of a container, by resource name.",
      "properties": {
        "limits": {
          "additionalProperties": {
            "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(([KMGTPE]i)|[numkMGTPE]|([eE][+-]?[0-9]+))?$",
            "type": "string"
          },
          "description": "Its limits.",
          "type": "object"
        },
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "requests": {
          "additionalProperties": {
            "pattern": "^[+-]?([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(([KMGTPE]i)|[numkMGTPE]|([eE][+-]?[0-9]+))?$",
            "type": "string"
          },
          "description": "Its requests.",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "RenderedProfile": {
      "additionalProperties": false,
      "description": "The objects of a component on one profile.",
      "properties": {
        "persistentVolumeClaims": {
          "description": "Its `PersistentVolumeClaims`.",
          "items": {
            "$ref": "#/$defs/RenderedClaim"
          },
          "type": "array"
        },
        "workloads": {
          "description": "Its workloads.",
          "items": {
            "$ref": "#/$defs/RenderedWorkload"
          },
          "type": "array"
        }
      },
      "required": [
        "workloads",
        "persistentVolumeClaims"
      ],
      "type": "object"
    },
    "RenderedWorkload": {
      "additionalProperties": false,
      "description": "A rendered workload. One that an operator creates later is missing.",
      "properties": {
        "containers": {
          "description": "Its containers.",
          "items": {
            "$ref": "#/$defs/RenderedContainer"
          },
          "type": "array"
        },
        "initContainers": {
          "description": "Its init containers.",
          "items": {
            "$ref": "#/$defs/RenderedContainer"
          },
          "type": "array"
        },
        "kind": {
          "$ref": "#/$defs/WorkloadKind",
          "description": "Its kind."
        },
        "name": {
          "description": "Its name.",
          "type": "string"
        },
        "namespace": {
          "description": "Its namespace.",
          "type": "string"
        },
        "release": {
          "description": "The release that renders it.",
          "type": "string"
        },
        "replicas": {
          "description": "`spec.replicas`; a `DaemonSet` has none.",
          "format": "int32",
          "type": "integer"
        },
        "volumeClaimTemplates": {
          "description": "The claims a `StatefulSet` makes for each pod.",
          "items": {
            "$ref": "#/$defs/RenderedClaim"
          },
          "type": "array"
        }
      },
      "required": [
        "release",
        "namespace",
        "name",
        "kind",
        "containers"
      ],
      "type": "object"
    },
    "RunResult": {
      "description": "Whether a run passed.",
      "oneOf": [
        {
          "const": "passed",
          "description": "It passed.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "It failed.",
          "type": "string"
        }
      ]
    },
    "WorkloadKind": {
      "description": "A workload kind that the catalog recognises by its labels or its rollout.",
      "oneOf": [
        {
          "const": "DaemonSet",
          "description": "`DaemonSet`.",
          "type": "string"
        },
        {
          "const": "Deployment",
          "description": "`Deployment`.",
          "type": "string"
        },
        {
          "const": "StatefulSet",
          "description": "`StatefulSet`.",
          "type": "string"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "declaration": {
      "$ref": "component.schema.json",
      "description": "`component.yaml` as written."
    },
    "id": {
      "description": "Its id.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "measurements": {
      "description": "Every recorded run of its e2e test.",
      "items": {
        "$ref": "#/$defs/Environment"
      },
      "type": "array"
    },
    "render": {
      "$ref": "#/$defs/Render",
      "description": "What it renders on each profile."
    },
    "sourceDigest": {
      "description": "The digest of its directory.",
      "type": "string"
    }
  },
  "required": [
    "id",
    "sourceDigest",
    "declaration",
    "render",
    "measurements"
  ],
  "type": "object"
}
