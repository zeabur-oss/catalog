{
  "$id": "https://oss-catalog.zeabur.com/v1/schema/template-file.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`templates/<id>.json`: the two files of a template as written.",
  "properties": {
    "id": {
      "description": "Its id.",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
    },
    "manifests": {
      "description": "The text of `manifests.yaml`, with template fields such as `{{ .Namespace }}`.",
      "type": "string"
    },
    "sourceDigest": {
      "description": "The digest of its directory.",
      "type": "string"
    },
    "template": {
      "$ref": "template.schema.json",
      "description": "`template.yaml` as written."
    }
  },
  "required": [
    "id",
    "sourceDigest",
    "template",
    "manifests"
  ],
  "title": "templates/<id>.json",
  "type": "object"
}
