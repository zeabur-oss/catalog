{
  "$defs": {
    "ApiVersion": {
      "description": "The `apiVersion` of every component and template file.",
      "oneOf": [
        {
          "const": "catalog.zeabur.com/v1",
          "description": "`catalog.zeabur.com/v1`.",
          "type": "string"
        }
      ]
    },
    "CpuMemory": {
      "additionalProperties": false,
      "description": "A CPU and a memory quantity.",
      "properties": {
        "cpu": {
          "description": "CPU, such as `50m`.",
          "pattern": "^[0-9]+(\\.[0-9]+)?m?$",
          "type": "string"
        },
        "memory": {
          "description": "Memory, such as `64Mi`.",
          "pattern": "^[1-9][0-9]*(Ki|Mi|Gi|Ti|Pi|Ei|k|M|G|T|P|E)?$",
          "type": "string"
        }
      },
      "required": [
        "cpu",
        "memory"
      ],
      "type": "object"
    },
    "Encoding": {
      "description": "How random bytes are written.",
      "oneOf": [
        {
          "const": "hex",
          "description": "Lowercase hexadecimal.",
          "type": "string"
        },
        {
          "const": "base64url",
          "description": "base64url without padding.",
          "type": "string"
        }
      ]
    },
    "Generate": {
      "description": "How an installer makes a value instead of asking for it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`bytes` random bytes in `encoding`.",
          "properties": {
            "bytes": {
              "description": "How many, 12 to 64.",
              "format": "uint8",
              "maximum": 64,
              "minimum": 12,
              "type": "integer"
            },
            "encoding": {
              "$ref": "#/$defs/Encoding",
              "description": "How they are written."
            },
            "type": {
              "const": "random",
              "type": "string"
            }
          },
          "required": [
            "type",
            "bytes",
            "encoding"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A free address in the cluster's Service CIDR, for a Service's fixed `ClusterIP`.",
          "properties": {
            "type": {
              "const": "clusterIP",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "HttpCheck": {
      "additionalProperties": false,
      "description": "A GET through a port-forward to a Service.",
      "properties": {
        "contains": {
          "default": null,
          "description": "Text the body contains.",
          "type": "string"
        },
        "path": {
          "description": "The path, from `/`.",
          "pattern": "^/",
          "type": "string"
        },
        "port": {
          "description": "Its port.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        },
        "service": {
          "description": "The Service.",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "type": "string"
        },
        "status": {
          "description": "The status it answers with.",
          "format": "uint16",
          "maximum": 599,
          "minimum": 100,
          "type": "integer"
        }
      },
      "required": [
        "service",
        "port",
        "path",
        "status"
      ],
      "type": "object"
    },
    "InputLocale": {
      "additionalProperties": false,
      "description": "An input's label and description in one language.",
      "properties": {
        "description": {
          "description": "What it is.",
          "minLength": 1,
          "type": "string"
        },
        "label": {
          "description": "A short name for the field.",
          "maxLength": 40,
          "type": "string"
        }
      },
      "required": [
        "label",
        "description"
      ],
      "type": "object"
    },
    "InputSecret": {
      "additionalProperties": false,
      "description": "A key of a Secret in the template's namespace.",
      "properties": {
        "key": {
          "description": "The key.",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "type": "string"
        },
        "name": {
          "description": "The Secret's name.",
          "pattern": "^[a-z0-9][a-z0-9.-]*$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "key"
      ],
      "type": "object"
    },
    "PodSecurity": {
      "description": "A Pod Security Standard level.",
      "oneOf": [
        {
          "const": "restricted",
          "description": "`restricted`.",
          "type": "string"
        },
        {
          "const": "baseline",
          "description": "`baseline`.",
          "type": "string"
        },
        {
          "const": "privileged",
          "description": "`privileged`.",
          "type": "string"
        }
      ]
    },
    "Port": {
      "additionalProperties": false,
      "description": "A named port of a service.",
      "properties": {
        "name": {
          "description": "Its name.",
          "minLength": 1,
          "type": "string"
        },
        "port": {
          "description": "Its number.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "port"
      ],
      "type": "object"
    },
    "Reference": {
      "description": "A component by id, or a capability: one component that provides it.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "`{component: <id>}`.",
          "properties": {
            "component": {
              "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
              "type": "string"
            }
          },
          "required": [
            "component"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "`{capability: <name>}`.",
          "properties": {
            "capability": {
              "pattern": "^[a-z0-9-]+$",
              "type": "string"
            }
          },
          "required": [
            "capability"
          ],
          "type": "object"
        }
      ]
    },
    "Risk": {
      "additionalProperties": false,
      "description": "A risk of a template and its mitigation.",
      "properties": {
        "locales": {
          "additionalProperties": {
            "$ref": "#/$defs/RiskLocale"
          },
          "description": "Both in other languages.",
          "propertyNames": {
            "pattern": "^([a-z]{2,3}(-[a-z]{3}){0,3}|[a-z]{4,8})(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?(-([a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(-[a-wyz0-9](-[a-z0-9]{2,8})+)*(-x(-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        },
        "mitigation": {
          "description": "How it is mitigated.",
          "minLength": 1,
          "type": "string"
        },
        "risk": {
          "description": "The risk.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "risk",
        "mitigation",
        "locales"
      ],
      "type": "object"
    },
    "RiskLocale": {
      "additionalProperties": false,
      "description": "A risk and its mitigation in one language.",
      "properties": {
        "mitigation": {
          "description": "How it is mitigated.",
          "minLength": 1,
          "type": "string"
        },
        "risk": {
          "description": "The risk.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "risk",
        "mitigation"
      ],
      "type": "object"
    },
    "Service": {
      "additionalProperties": false,
      "description": "A workload in `manifests.yaml`.",
      "properties": {
        "domains": {
          "default": [],
          "description": "Public hostnames; rendering then needs a domain and a `ClusterIssuer`.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "name": {
          "description": "Its name.",
          "maxLength": 53,
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "podSecurity": {
          "$ref": "#/$defs/PodSecurity",
          "description": "The level its pods meet.",
          "enum": [
            "restricted",
            "baseline"
          ]
        },
        "ports": {
          "default": [],
          "description": "Its named ports.",
          "items": {
            "$ref": "#/$defs/Port"
          },
          "type": "array"
        },
        "resources": {
          "$ref": "#/$defs/ServiceResources",
          "description": "Its requests and limits."
        }
      },
      "required": [
        "name",
        "podSecurity",
        "resources"
      ],
      "type": "object"
    },
    "ServiceResources": {
      "additionalProperties": false,
      "description": "The requests and limits of a service.",
      "properties": {
        "limits": {
          "$ref": "#/$defs/CpuMemory",
          "description": "What it may use."
        },
        "requests": {
          "$ref": "#/$defs/CpuMemory",
          "description": "What it requests."
        }
      },
      "required": [
        "requests",
        "limits"
      ],
      "type": "object"
    },
    "SqlCheck": {
      "additionalProperties": false,
      "description": "One read-only `SELECT` on a `CloudNativePG` primary.",
      "properties": {
        "cluster": {
          "description": "The `CloudNativePG` cluster.",
          "pattern": "^[a-z][a-z0-9-]*$",
          "type": "string"
        },
        "database": {
          "description": "The database.",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
          "type": "string"
        },
        "expect": {
          "description": "What it prints.",
          "type": "string"
        },
        "query": {
          "description": "The query.",
          "pattern": "^[Ss][Ee][Ll][Ee][Cc][Tt] ",
          "type": "string"
        }
      },
      "required": [
        "cluster",
        "database",
        "query",
        "expect"
      ],
      "type": "object"
    },
    "Summary": {
      "additionalProperties": false,
      "description": "A name and a summary in English, with the summary in other languages.",
      "properties": {
        "summary": {
          "description": "One line.",
          "pattern": "^[^\\n]+$",
          "type": "string"
        }
      },
      "required": [
        "summary"
      ],
      "type": "object"
    },
    "TemplateInput": {
      "additionalProperties": false,
      "description": "A value the person installing gives, or the installer generates into a Secret.",
      "oneOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "required"
                ]
              },
              {
                "required": [
                  "default"
                ]
              }
            ]
          },
          "required": [
            "generate",
            "secret"
          ]
        },
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "generate"
                ]
              },
              {
                "required": [
                  "secret"
                ]
              }
            ]
          },
          "required": [
            "required",
            "label",
            "locales"
          ]
        }
      ],
      "properties": {
        "default": {
          "default": null,
          "description": "The value when a deploy does not give it.",
          "type": "string"
        },
        "description": {
          "description": "What it is, in English.",
          "minLength": 1,
          "type": "string"
        },
        "generate": {
          "$ref": "#/$defs/Generate",
          "default": null,
          "description": "How the installer makes it."
        },
        "label": {
          "default": null,
          "description": "A short name for the field, in English.",
          "maxLength": 40,
          "type": "string"
        },
        "locales": {
          "additionalProperties": {
            "$ref": "#/$defs/InputLocale"
          },
          "default": {},
          "description": "The label and description in other languages.",
          "propertyNames": {
            "pattern": "^([a-z]{2,3}(-[a-z]{3}){0,3}|[a-z]{4,8})(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?(-([a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(-[a-wyz0-9](-[a-z0-9]{2,8})+)*(-x(-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "description": "Its name, camelCase.",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "type": "string"
        },
        "required": {
          "default": false,
          "description": "A deploy needs a value.",
          "type": "boolean"
        },
        "secret": {
          "$ref": "#/$defs/InputSecret",
          "default": null,
          "description": "The Secret key a generated value is stored in."
        },
        "validation": {
          "$ref": "#/$defs/Validation",
          "description": "What the value must match."
        }
      },
      "required": [
        "name",
        "description",
        "validation"
      ],
      "type": "object"
    },
    "TemplateKind": {
      "description": "The `kind` of a template file.",
      "oneOf": [
        {
          "const": "Template",
          "description": "`Template`.",
          "type": "string"
        }
      ]
    },
    "TemplateMetadata": {
      "additionalProperties": false,
      "description": "A template's name, summary, version and docs.",
      "properties": {
        "docs": {
          "description": "The upstream docs on how to use the application.",
          "format": "uri",
          "pattern": "^https://",
          "type": "string"
        },
        "homepage": {
          "description": "The project's home page.",
          "format": "uri",
          "pattern": "^https?://",
          "type": "string"
        },
        "license": {
          "description": "An SPDX expression for the application, its images and charts.",
          "minLength": 1,
          "type": "string"
        },
        "licenseUrls": {
          "additionalProperties": {
            "format": "uri",
            "pattern": "^https://",
            "type": "string"
          },
          "description": "The URL of the text of each `LicenseRef-` licence in `license`, by its id.",
          "propertyNames": {
            "pattern": "^LicenseRef-[A-Za-z0-9.-]+$",
            "type": "string"
          },
          "type": "object"
        },
        "locales": {
          "additionalProperties": {
            "$ref": "#/$defs/Summary"
          },
          "description": "The summary in other languages.",
          "propertyNames": {
            "pattern": "^([a-z]{2,3}(-[a-z]{3}){0,3}|[a-z]{4,8})(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?(-([a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(-[a-wyz0-9](-[a-z0-9]{2,8})+)*(-x(-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "description": "The name for people.",
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "description": "What the application is, in one plain sentence.",
          "pattern": "^[^\\n]+$",
          "type": "string"
        },
        "version": {
          "description": "The tag of its main image.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "summary",
        "locales",
        "license",
        "homepage",
        "docs",
        "version"
      ],
      "type": "object"
    },
    "TemplateSecurity": {
      "additionalProperties": false,
      "description": "What a template exposes and how its risks are mitigated.",
      "properties": {
        "locales": {
          "additionalProperties": {
            "$ref": "#/$defs/Summary"
          },
          "default": {},
          "description": "The summary in other languages.",
          "propertyNames": {
            "pattern": "^([a-z]{2,3}(-[a-z]{3}){0,3}|[a-z]{4,8})(-[A-Z][a-z]{3})?(-([A-Z]{2}|[0-9]{3}))?(-([a-z0-9]{5,8}|[0-9][a-z0-9]{3}))*(-[a-wyz0-9](-[a-z0-9]{2,8})+)*(-x(-[a-z0-9]{1,8})+)?$",
            "type": "string"
          },
          "type": "object"
        },
        "risks": {
          "description": "Its risks.",
          "items": {
            "$ref": "#/$defs/Risk"
          },
          "type": "array"
        },
        "summary": {
          "description": "What it exposes.",
          "minLength": 1,
          "type": "string"
        },
        "unauthenticated": {
          "default": [],
          "description": "Services with no sign-in or key of their own.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "summary",
        "risks"
      ],
      "type": "object"
    },
    "TemplateSmoke": {
      "additionalProperties": false,
      "description": "An e2e check after install.",
      "else": {
        "required": [
          "condition"
        ]
      },
      "if": {
        "properties": {
          "resource": {
            "pattern": "^([Dd]aemon[Ss]et|[Dd]eployment|[Ss]tateful[Ss]et)(/|$)"
          }
        }
      },
      "properties": {
        "condition": {
          "default": null,
          "description": "What it reaches, as a `kubectl wait --for` value.",
          "pattern": "^(condition=[A-Za-z][A-Za-z0-9]*(=(True|False|Unknown))?|jsonpath=.+)$",
          "type": "string"
        },
        "http": {
          "$ref": "#/$defs/HttpCheck",
          "default": null,
          "description": "A GET through a port-forward to a Service."
        },
        "name": {
          "description": "Its name.",
          "minLength": 1,
          "type": "string"
        },
        "resource": {
          "description": "The object to wait for, as `kind/name`.",
          "pattern": "^[a-zA-Z0-9.-]+/[a-z0-9][a-z0-9.-]*$",
          "type": "string"
        },
        "sql": {
          "$ref": "#/$defs/SqlCheck",
          "default": null,
          "description": "One read-only `SELECT` on a `CloudNativePG` primary."
        },
        "timeout": {
          "description": "How long to wait.",
          "pattern": "^[1-9][0-9]*(s|m)$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "resource",
        "timeout"
      ],
      "then": {
        "not": {
          "required": [
            "condition"
          ]
        }
      },
      "type": "object"
    },
    "Validation": {
      "additionalProperties": false,
      "description": "What an input's value must match.",
      "properties": {
        "pattern": {
          "description": "A regular expression the whole value matches.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "type": "object"
    }
  },
  "$id": "https://oss-catalog.zeabur.com/v1/schema/template.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One application that a project member installs into one namespace.",
  "properties": {
    "apiVersion": {
      "$ref": "#/$defs/ApiVersion",
      "description": "`catalog.zeabur.com/v1`."
    },
    "inputs": {
      "default": [],
      "description": "Values a person gives or the installer generates.",
      "items": {
        "$ref": "#/$defs/TemplateInput"
      },
      "type": "array"
    },
    "kind": {
      "$ref": "#/$defs/TemplateKind",
      "description": "`Template`."
    },
    "metadata": {
      "$ref": "#/$defs/TemplateMetadata",
      "description": "Its name, summary, version and docs."
    },
    "requires": {
      "default": [],
      "description": "The components the cluster must have.",
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "type": "array",
      "uniqueItems": true
    },
    "security": {
      "$ref": "#/$defs/TemplateSecurity",
      "description": "What it exposes and how its risks are mitigated."
    },
    "services": {
      "description": "The workloads in `manifests.yaml`.",
      "items": {
        "$ref": "#/$defs/Service"
      },
      "minItems": 1,
      "type": "array"
    },
    "smoke": {
      "description": "e2e checks after install, in the template's namespace.",
      "items": {
        "$ref": "#/$defs/TemplateSmoke"
      },
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "services",
    "security",
    "smoke"
  ],
  "title": "Template",
  "type": "object"
}
