{
  "$defs": {
    "CatalogRelease": {
      "additionalProperties": false,
      "description": "The catalog release an API was built from.",
      "properties": {
        "commit": {
          "description": "The Git commit.",
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "version": {
          "description": "`0.5.6`.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "commit"
      ],
      "type": "object"
    },
    "Distribution": {
      "description": "A host distribution of Kubernetes that a component runs on.",
      "oneOf": [
        {
          "const": "k3s",
          "description": "K3s.",
          "type": "string"
        },
        {
          "const": "rke2",
          "description": "RKE2.",
          "type": "string"
        },
        {
          "const": "kubesolo",
          "description": "KubeSolo.",
          "type": "string"
        }
      ]
    },
    "Entry": {
      "additionalProperties": false,
      "description": "A component or template in `catalog.json`.",
      "properties": {
        "id": {
          "description": "Its directory name.",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "type": "string"
        },
        "sourceDigest": {
          "description": "The Go module hash (`h1:`) of its directory without its READMEs.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceDigest"
      ],
      "type": "object"
    },
    "PinnedDistribution": {
      "additionalProperties": false,
      "description": "The release of a distribution that e2e installs on the host.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Distribution",
          "description": "The distribution."
        },
        "version": {
          "description": "Its release, such as `v1.37.2+k3s1`.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "type": "object"
    },
    "Profile": {
      "description": "A deployment layout. Every component describes both.",
      "oneOf": [
        {
          "const": "single-node",
          "description": "One node.",
          "type": "string"
        },
        {
          "const": "multi-node",
          "description": "Three nodes or more.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "https://oss-catalog.zeabur.com/v1/schema/catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`catalog.json`: the release, its test environments, its components and its templates.",
  "properties": {
    "catalog": {
      "$ref": "#/$defs/CatalogRelease",
      "description": "The release."
    },
    "components": {
      "description": "Each component's id and digest.",
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "type": "array"
    },
    "distributions": {
      "description": "The release of each host distribution that e2e installs.",
      "items": {
        "$ref": "#/$defs/PinnedDistribution"
      },
      "type": "array"
    },
    "kubernetes": {
      "description": "The Kubernetes versions every profile is rendered against.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "profiles": {
      "description": "The profiles every component describes.",
      "items": {
        "$ref": "#/$defs/Profile"
      },
      "type": "array"
    },
    "templates": {
      "description": "Each template's id and digest.",
      "items": {
        "$ref": "#/$defs/Entry"
      },
      "type": "array"
    }
  },
  "required": [
    "catalog",
    "profiles",
    "kubernetes",
    "distributions",
    "components",
    "templates"
  ],
  "title": "catalog.json",
  "type": "object"
}
