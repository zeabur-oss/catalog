        "chart": "mariadb-operator",
        "chartDigest": "sha256:db364a229041e55bcd58e79dbdc723a8ff33e2a512c47551d1502cd7b0c75e07",
        "name": "mariadb-operator",
        "namespace": "mariadb-operator",
        "profiles": {
          "multi-node": "ha:\n  # Leader election keeps one active; survives a drain.\n  enabled: true\n  replicas: 2\nresources:\n  # Single-node's request; the leader uses about 54Mi on a two-node\n  # cluster with apps. The limit leaves room for more MariaDB objects.\n  requests: {cpu: 10m, memory: 64Mi}\n  limits: {memory: 512Mi}\nwebhook:\n  ha:\n    # Admission keeps working during a drain.\n    enabled: true\n    replicas: 2\n  resources:\n    # Only admits MariaDB objects.\n    requests: {cpu: 10m, memory: 32Mi}\n    limits: {memory: 128Mi}\n",
          "single-node": "resources:\n  # The chart sets none; grows with MariaDB objects.\n  requests: {cpu: 10m, memory: 64Mi}\n  limits: {memory: 256Mi}\nwebhook:\n  resources:\n    # Only admits MariaDB objects.\n    requests: {cpu: 10m, memory: 32Mi}\n    limits: {memory: 128Mi}\n"
        },
        "repo": "https://helm.mariadb.com/mariadb-operator",
        "type": "helm",
        "values": "# Pinned by digest; a tag alone can move.\nimage:\n  repository: ghcr.io/mariadb-operator/mariadb-operator\n  tag: 26.10.1@sha256:37714fb240a53b2a496fd77d784879961b098bdbe0ef344ac7ba703ee3632017\ncrds:\n  # From the mariadb-operator-crds release.\n  enabled: false\nextraEnv:\n  # With client-go's streaming list, the controllers start 90 s or more late\n  # on a new KubeSolo cluster, often past their cache-sync limit, and the\n  # manager exits.\n  - {name: KUBE_FEATURE_WatchListClient, value: \"false\"}\nwebhook:\n  # The operator image, pinned by digest.\n  image:\n    repository: ghcr.io/mariadb-operator/mariadb-operator\n    tag: 26.10.1@sha256:37714fb240a53b2a496fd77d784879961b098bdbe0ef344ac7ba703ee3632017\n  cert:\n    certManager:\n      # cert-manager issues the webhook certificate, so the chart's\n      # cert-controller Deployment is not installed.\n      enabled: true\n  # Restricted Pod Security; the chart sets none.\n  podSecurityContext:\n    runAsNonRoot: true\n    seccompProfile: {type: RuntimeDefault}\n  # Restricted Pod Security; the chart sets none.\n  securityContext:\n    allowPrivilegeEscalation: false\n    readOnlyRootFilesystem: true\n    capabilities: {drop: [ALL]}\n# Restricted Pod Security; the chart sets none.\npodSecurityContext:\n  runAsNonRoot: true\n  seccompProfile: {type: RuntimeDefault}\n# Restricted Pod Security; the chart sets none.\nsecurityContext:\n  allowPrivilegeEscalation: false\n  readOnlyRootFilesystem: true\n  capabilities: {drop: [ALL]}\n",
        "version": "26.10.2"
      }
    ],
    "requires": [
      {
        "capability": "certificates"
      }
    ],
    "security": {
      "podSecurity": "restricted",
      "summary": "Manages pods, Services, Secrets, PVCs, Jobs and RBAC for MariaDB objects in every namespace."
    },
    "smoke": [
      {
        "manifest": "# Proves MariaDB runs under restricted Pod Security.\napiVersion: v1\nkind: Namespace\nmetadata:\n  name: catalog-smoke\n  labels: {pod-security.kubernetes.io/enforce: restricted}\n---\napiVersion: k8s.mariadb.com/v1alpha1\nkind: MariaDB\nmetadata: {name: smoke, namespace: catalog-smoke}\nspec:\n  storage: {size: 1Gi}\n  podSecurityContext:\n    runAsNonRoot: true\n    runAsUser: 999\n    runAsGroup: 999\n    fsGroup: 999\n    seccompProfile: {type: RuntimeDefault}\n  securityContext:\n    allowPrivilegeEscalation: false\n    capabilities: {drop: [ALL]}\n",
        "name": "standalone",
        "timeout": "600s",
        "wait": [
          "-n catalog-smoke mariadb/smoke --for=condition=Ready"
        ]
      }
    ]
  },
