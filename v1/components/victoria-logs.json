{
  "id": "victoria-logs",
  "sourceDigest": "h1:BJGqTdn+MjaduoCkam733gPaPe8ZGuut9Et/w4NElcg=",
  "declaration": {
    "apiVersion": "catalog.zeabur.com/v1",
    "defaults": {
      "multi-node": "recommended",
      "single-node": "recommended"
    },
    "detection": {
      "crds": [
        "vlsingles.operator.victoriametrics.com"
      ],
      "helmCharts": [
        "victoria-logs-single",
        "victoria-logs-collector"
      ],
      "workloads": [
        {
          "kind": "Deployment",
          "labels": {
            "app.kubernetes.io/name": "vlsingle"
          }
        },
        {
          "kind": "StatefulSet",
          "labels": {
            "app.kubernetes.io/name": "victoria-logs-single"
          }
        }
      ]
    },
    "distributions": [
      "k3s",
      "rke2",
      "kubesolo"
    ],
    "kind": "Component",
    "kubeVersion": "\u003e=1.34.0-0",
    "leftovers": [
      "persistentvolumeclaims"
    ],
    "metadata": {
      "homepage": "https://docs.victoriametrics.com/victorialogs/",
      "license": "Apache-2.0",
      "locales": {
        "zh-CN": {
          "summary": "保存并搜索日志。"
        },
        "zh-TW": {
          "summary": "保存並搜尋日誌。"
        }
      },
      "name": "VictoriaLogs",
      "summary": "Keeps and searches logs."
    },
    "persistsData": true,
    "provides": {
      "capability": "logs"
    },
    "releases": [
      {
        "manifests": "# The log store.\napiVersion: operator.victoriametrics.com/v1\nkind: VLSingle\nmetadata:\n  name: victoria-logs\n  namespace: observability\nspec:\n  # Two weeks, or less when the volume reaches 8GiB of its 10Gi.\n  retentionPeriod: 14d\n  retentionMaxDiskSpaceUsageBytes: 8GiB\n  storage:\n    resources:\n      requests: {storage: 10Gi}\n  extraArgs:\n    # Caches stop at 128MiB instead of 60% of the limit.\n    memory.allowedBytes: 128MiB\n    search.maxConcurrentRequests: \"2\"\n    defaultParallelReaders: \"2\"\n  resources:\n    requests: {cpu: 50m, memory: 64Mi}\n    limits: {memory: 384Mi}\n---\n# One collector per node, reading container logs.\napiVersion: operator.victoriametrics.com/v1\nkind: VLAgent\nmetadata:\n  name: collector\n  namespace: observability\nspec:\n  k8sCollector:\n    enabled: true\n    # Their lines are noise that shares the 8GiB budget with the project logs, and\n    # observability would feed the collector's own errors back.\n    excludeFilter: kubernetes.pod_namespace:in(kube-system, kube-public, kube-node-lease, observability)\n  # Namespace, pod and container suffice; labels add cardinality. The\n  # operator (v0.75.0) passes no flag for k8sCollector.includePodLabels:\n  # false, and vlagent's default is true.\n  extraArgs:\n    kubernetesCollector.includePodLabels: \"false\"\n    # kube-apiserver's audit log, under the /var/lib the collector already mounts\n    # read-only. K3s and RKE2 write it in their own directory, and only\n    # control-plane nodes have the file. Rotated backups are followed, not read again.\n    fileCollector.glob: /var/lib/rancher/*/server/logs/audit.log\n    fileCollector.extraFields: '{\"app\":\"kube-apiserver-audit\",\"node\":\"%{NODE_NAME}\"}'\n    fileCollector.streamFields: app,node\n    fileCollector.timeField: stageTimestamp\n    fileCollector.msgField: requestURI\n    envflag.enable: \"true\"\n  extraEnvs:\n    - name: NODE_NAME\n      valueFrom: {fieldRef: {fieldPath: spec.nodeName}}\n  remoteWriteSettings:\n    queues: 1\n    # What the node keeps while the log store is down.\n    maxDiskUsagePerURL: 512MiB\n  remoteWrite:\n    - url: http://vlsingle-victoria-logs.observability.svc:9428/internal/insert\n  resources:\n    requests: {cpu: 20m, memory: 16Mi}\n    limits: {memory: 128Mi}\n---\n# Only the collector, the metrics stack's vmagent (the operator's scrape of\n# /metrics) and Zeabur Proxy in the zeabur namespace reach the log store.\napiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: victoria-logs\n  namespace: observability\nspec:\n  podSelector:\n    matchLabels: {app.kubernetes.io/name: vlsingle, app.kubernetes.io/instance: victoria-logs}\n  policyTypes: [Ingress]\n  ingress:\n    - ports: [{port: 9428, protocol: TCP}]\n      from:\n        - podSelector:\n            matchLabels: {app.kubernetes.io/name: vlagent, app.kubernetes.io/instance: collector}\n        - podSelector:\n            matchLabels: {app.kubernetes.io/name: vmagent}\n        # Both selectors: anyone can label a pod in their own namespace.\n        - namespaceSelector:\n            matchLabels: {kubernetes.io/metadata.name: zeabur}\n          podSelector:\n            matchLabels: {app.kubernetes.io/name: zeabur-proxy}\n",
        "name": "logs",
        "namespace": "observability",
        "type": "inline"
      }
    ],
    "requires": [
      {
        "component": "victoria-metrics-operator"
      }
    ],
    "resources": {
      "work": [
        {
          "name": "load",
          "use": {
            "memory": "64Mi"
          }
        }
      ]
    },
    "security": {
      "podSecurity": "privileged",
      "summary": "The collector reads pod metadata, node log files and kube-apiserver's audit log."
    },
    "smoke": [
      {
        "name": "operational",
        "wait": [
          "-n observability vlsingle/victoria-logs --for=jsonpath={.status.updateStatus}=operational",
          "-n observability vlagent/collector --for=jsonpath={.status.updateStatus}=operational"
        ]
      }
    ]
  },
  "render": {
    "kubernetesVersion": "1.37.0",
    "profiles": {
      "multi-node": {
        "workloads": [],
        "persistentVolumeClaims": []
      },
      "single-node": {
        "workloads": [],
        "persistentVolumeClaims": []
      }
    }
  },
