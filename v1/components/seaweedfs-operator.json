{
  "id": "seaweedfs-operator",
  "sourceDigest": "h1:VGIsKPZiWyJ8xq0vYdG/DywtdpT7R8R7qGIWtnzz3os=",
  "declaration": {
    "apiVersion": "catalog.zeabur.com/v1",
