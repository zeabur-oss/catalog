    ],
    "metadata": {
      "homepage": "https://aquasecurity.github.io/trivy-operator/",
      "license": "Apache-2.0",
      "locales": {
        "zh-CN": {
          "summary": "扫描运行中的镜像和配置，找出已知漏洞。"
        },
        "zh-TW": {
          "summary": "掃描執行中的映像檔與設定，找出已知弱點。"
        }
      },
      "name": "Trivy Operator",
      "summary": "Scans running images and settings for known vulnerabilities."
    },
    "provides": {
      "capability": "vulnerability-scanning"
    },
    "releases": [
      {
        "chart": "trivy-operator",
        "chartDigest": "sha256:9c1de16f159bb9e1fca820b43cd7c5b1475fa869c2ce90541db0e747e8a4c674",
        "name": "trivy-operator",
        "namespace": "trivy-system",
        "profiles": {
          "multi-node": "operator:\n  # A few parallel scans keep reports fresh without flooding nodes.\n  scanJobsConcurrentLimit: 3\nresources:\n  # More workloads to track.\n  requests: {cpu: 50m, memory: 128Mi}\n  limits: {memory: 1Gi}\n",
          "single-node": "operator:\n  # One scan at a time; each job loads an image and the DB.\n  scanJobsConcurrentLimit: 1\n  # One report per (mostly system) role; RBAC review is an admin task.\n  rbacAssessmentScannerEnabled: false\ntrivy:\n  # Low severity is noise on a small cluster.\n  severity: MEDIUM,HIGH,CRITICAL\nresources:\n  # The operator idles under 100Mi; scan jobs set their own.\n  requests: {cpu: 20m, memory: 64Mi}\n  limits: {memory: 512Mi}\n"
        },
        "repo": "https://aquasecurity.github.io/helm-charts",
        "type": "helm",
        "values": "# Pinned by digest; a tag alone can move. The chart joins registry and\n# repository. registry comes second, so Renovate reads both.\nimage:\n  repository: aquasec/trivy-operator\n  registry: mirror.gcr.io\n  tag: 0.35.0@sha256:4cdb11af98ff409cfa7af980098203a841a5fe957cc6a0bbb0df7668065eb5fa\n# The chart's container context is restricted already; the pod context lacks runAsNonRoot and seccomp.\npodSecurityContext:\n  runAsNonRoot: true\n  seccompProfile: {type: RuntimeDefault}\noperator:\n  # Reading every Secret is too broad; list pull secrets explicitly.\n  accessGlobalSecretsAndServiceAccount: false\n  # Compliance scans run privileged collectors; opt in explicitly.\n  infraAssessmentScannerEnabled: false\n  clusterComplianceEnabled: false\n  # SBOMs duplicate vulnerability reports and inflate operator memory.\n  sbomGenerationEnabled: false\ntrivy:\n  # Only fixable findings are actionable.\n  ignoreUnfixed: true\n",
        "version": "0.38.1"
      }
    ],
    "security": {
      "podSecurity": "restricted",
      "summary": "Reads workloads cluster-wide, runs scan Jobs and writes reports next to workloads."
    }
  },
  "render": {
    "kubernetesVersion": "1.37.0",
    "profiles": {
      "multi-node": {
        "workloads": [
          {
            "release": "trivy-operator",
            "namespace": "trivy-system",
            "name": "trivy-operator",
            "kind": "Deployment",
