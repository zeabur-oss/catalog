      "name": "Kubernetes Metrics Server",
      "summary": "Shows the CPU and memory each pod uses right now."
    },
    "networkPolicies": "apiVersion: networking.k8s.io/v1\nkind: NetworkPolicy\nmetadata:\n  name: metrics-server-apiserver\n  namespace: kube-system\nspec:\n  podSelector:\n    matchLabels: {app.kubernetes.io/name: metrics-server}\n  policyTypes: [Ingress]\n  ingress:\n    - ports: [{protocol: TCP, port: 10250}]\n",
    "provides": {
      "capability": "metrics"
    },
    "releases": [
      {
        "chart": "metrics-server",
        "chartDigest": "sha256:c2ca1185c01e6e7f53dd1b7d131f0c9b3fa50e003ed068b784563a1b5a3422a1",
        "name": "metrics-server",
        "namespace": "kube-system",
        "profiles": {
          "multi-node": "# HPA stops while metrics.k8s.io is down; two replicas.\nreplicas: 2\npodDisruptionBudget:\n  # Keep one replica during node drains.\n  enabled: true\n  minAvailable: 1\nresources:\n  # Covers clusters of a few dozen nodes.\n  requests: {cpu: 50m, memory: 96Mi}\n  limits: {memory: 256Mi}\n",
          "single-node": "resources:\n  # Idles near 25Mi; the chart's 200Mi request is sized for 100+ nodes.\n  requests: {cpu: 20m, memory: 32Mi}\n  limits: {memory: 128Mi}\n"
        },
        "repo": "https://kubernetes-sigs.github.io/metrics-server",
        "type": "helm",
        "values": "# Pinned by digest; a tag alone can move.\nimage:\n  repository: registry.k8s.io/metrics-server/metrics-server\n  tag: v0.9.0@sha256:d9862115e7c7881280d3d75ca26bda8ffc0fc213315979575bf23ce9826205c0\nargs:\n  # 15s is fresh enough for live views; the default is 60s.\n  - --metric-resolution=15s\n",
        "version": "3.14.0"
      }
    ],
    "security": {
      "podSecurity": "restricted",
      "summary": "Reads kubelet metrics; registers an aggregated API."
    }
  },
