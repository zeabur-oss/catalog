            "release": "falco",
            "namespace": "falco",
            "name": "falco-falcosidekick",
            "kind": "Deployment",
            "replicas": 1,
            "containers": [
              {
                "name": "falcosidekick",
                "requests": {
                  "cpu": "10m",
                  "memory": "32Mi"
                },
                "limits": {
                  "memory": "128Mi"
                }
              }
            ]
          }
        ],
