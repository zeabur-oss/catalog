{
  "id": "external-secrets",
  "sourceDigest": "h1:777w7FTmVTZ2IPTh8Ouc6EzPR78lz1a1ur8er3+7Icc=",
  "declaration": {
    "apiVersion": "catalog.zeabur.com/v1",
    "defaults": {
      "multi-node": "optional",
      "single-node": "optional"
    },
    "detection": {
      "crds": [
        "externalsecrets.external-secrets.io"
      ],
      "helmCharts": [
        "external-secrets"
      ],
      "workloads": [
        {
          "kind": "Deployment",
          "labels": {
            "app.kubernetes.io/name": "external-secrets"
          }
        }
      ]
    },
    "distributions": [
      "k3s",
      "rke2",
      "kubesolo"
    ],
    "kind": "Component",
    "kubeVersion": "\u003e=1.19.0-0",
    "metadata": {
      "homepage": "https://external-secrets.io",
      "license": "Apache-2.0",
      "locales": {
        "zh-CN": {
          "summary": "把 Vault、1Password 等外部存储的密钥复制进集群，并保持同步。"
        },
        "zh-TW": {
          "summary": "把 Vault、1Password 等外部儲存的機密複製進叢集，並保持同步。"
        }
      },
      "name": "External Secrets Operator",
      "summary": "Copies secrets from a store such as Vault or 1Password into the cluster and keeps them in sync."
    },
    "provides": {
      "capability": "external-secrets"
    },
    "releases": [
      {
        "chart": "external-secrets",
        "chartDigest": "sha256:0a6d9e91b1ff50adfdbf24b50b582babfa7c5b7df42b21974ca4b3fb88ee5e34",
        "name": "external-secrets",
        "namespace": "external-secrets",
        "profiles": {
          "multi-node": "# One leader and one standby, so a node drain does not stop syncs.\nreplicaCount: 2\n# Only the leader reconciles.\nleaderElect: true\n# More namespaces and Secrets to cache.\nresources:\n  requests: {cpu: 20m, memory: 128Mi}\n  limits: {cpu: 500m, memory: 512Mi}\nwebhook:\n  # Two replicas: with failurePolicy Fail, no webhook means no writes\n  # to its CRDs.\n  replicaCount: 2\n  resources:\n    requests: {cpu: 10m, memory: 32Mi}\n    limits: {cpu: 100m, memory: 128Mi}\n",
          "single-node": "resources:\n  # Caches ExternalSecrets and the Secrets it owns.\n  requests: {cpu: 10m, memory: 64Mi}\n  limits: {cpu: 200m, memory: 256Mi}\nwebhook:\n  # Validates CRD writes only.\n  resources:\n    requests: {cpu: 10m, memory: 32Mi}\n    limits: {cpu: 100m, memory: 128Mi}\n"
        },
        "repo": "https://charts.external-secrets.io",
        "type": "helm",
        "values": "# Pinned by digest; the chart's tag alone can move.\nimage:\n  repository: ghcr.io/external-secrets/external-secrets\n  tag: v2.13.0@sha256:f799d87a6a959e597a4ba7a8d2379886292c3fcfbee678f7dc2d3566051bcb96\n# Off in the chart. Both use the health server on port 8082.\nlivenessProbe:\n  enabled: true\n# Ready once the controller has synced its caches.\nreadinessProbe:\n  enabled: true\nwebhook:\n  # The same image as the controller.\n  image:\n    repository: ghcr.io/external-secrets/external-secrets\n    tag: v2.13.0@sha256:f799d87a6a959e597a4ba7a8d2379886292c3fcfbee678f7dc2d3566051bcb96\n  # Off in the chart. /healthz on port 8081.\n  livenessProbe:\n    enabled: true\n  # cert-manager issues the webhook certificate and injects its CA, so\n  # the cert controller and its cluster-wide webhook RBAC are not needed.\n  certManager:\n    enabled: true\n    cert:\n      issuerRef:\n        group: cert-manager.io\n        kind: Issuer\n        name: external-secrets-selfsigned\n# cert-manager issues the webhook certificate instead.\ncertController:\n  create: false\nextraObjects:\n  # Signs the webhook certificate; nothing else uses it.\n  - apiVersion: cert-manager.io/v1\n    kind: Issuer\n    metadata:\n      name: external-secrets-selfsigned\n      namespace: external-secrets\n    spec:\n      selfSigned: {}\n",
        "version": "2.14.0"
      }
    ],
    "requires": [
      {
        "capability": "certificates"
      }
    ],
    "security": {
      "podSecurity": "restricted",
      "summary": "ClusterRole: reads, creates, updates and deletes Secrets in every namespace; creates ServiceAccount tokens in every namespace (for SecretStores that authenticate as a ServiceAccount); reads ConfigMaps, ServiceAccounts and its own CRDs; reads and updates Namespaces; creates Events. The webhook has no RBAC. The chart aggregates read access to its CRDs into view, and write access into edit and admin.\n"
    },
    "smoke": [
      {
        "name": "ready",
        "wait": [
          "-n external-secrets certificate --all --for=condition=Ready",
          "-n external-secrets deployment/external-secrets --for=condition=Available",
          "-n external-secrets deployment/external-secrets-webhook --for=condition=Available"
        ]
      },
      {
        "manifest": "apiVersion: external-secrets.io/v1\nkind: SecretStore\nmetadata: {name: smoke, namespace: catalog-smoke}\nspec:\n  provider:\n    fake:\n      data:\n        - key: smoke\n          value: synced\n---\napiVersion: external-secrets.io/v1\nkind: ExternalSecret\nmetadata: {name: smoke, namespace: catalog-smoke}\nspec:\n  refreshInterval: 1m\n  secretStoreRef: {kind: SecretStore, name: smoke}\n  target: {name: smoke}\n  data:\n    - secretKey: value\n      remoteRef: {key: smoke}\n",
        "name": "fake-store-sync",
        "wait": [
          "-n catalog-smoke secretstore/smoke --for=condition=Ready",
          "-n catalog-smoke externalsecret/smoke --for=condition=Ready",
          "-n catalog-smoke secret/smoke --for=jsonpath={.data.value}=c3luY2Vk"
        ]
      }
    ]
  },
