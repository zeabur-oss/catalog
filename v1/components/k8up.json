    "metadata": {
      "homepage": "https://k8up.io",
      "license": "Apache-2.0",
      "locales": {
        "zh-CN": {
          "summary": "把各项目的卷备份到兼容 S3 的存储，数据库备份不需要它。"
        },
        "zh-TW": {
          "summary": "備份各專案的磁碟區，存到相容 S3 的儲存空間，資料庫備份不需要它。"
        }
      },
      "name": "K8up",
      "summary": "Backs up each project's volumes to S3-compatible storage; database backups don't need it."
    },
    "provides": {
      "capability": "volume-backup"
    },
    "releases": [
      {
        "chart": "k8up",
        "chartDigest": "sha256:6d8a2e69ea3b75e25de80b4d173b2858e337586edf603c485567c5bf1ec8697a",
        "name": "k8up",
        "namespace": "k8up-system",
        "profiles": {
          "multi-node": "# Keeps schedules firing through node drains.\nreplicaCount: 2\nresources:\n  # Single-node's request; the leader uses about 20Mi on a two-node\n  # cluster with apps. The limit leaves room for more schedules.\n  requests: {cpu: 10m, memory: 32Mi}\n  limits: {memory: 512Mi}\n",
          "single-node": "k8up:\n  # No leader election with a single replica.\n  enableLeaderElection: false\nresources:\n  # Idle between schedules; backup Jobs have their own requests.\n  requests: {cpu: 10m, memory: 32Mi}\n  limits: {memory: 256Mi}\n"
        },
        "repo": "https://k8up-io.github.io/k8up",
        "type": "helm",
        "values": "# Pinned by digest; a tag alone can move. The chart joins registry and\n# repository. registry comes second, so Renovate reads both.\nimage:\n  repository: k8up-io/k8up\n  registry: ghcr.io\n  tag: v2.16.1@sha256:f59bfa37c51511d5ad67e53816fb55c62d0e6411890e59bb6b965923129f30b5\nk8up:\n  # Back up only PVCs annotated for backup.\n  skipWithoutAnnotation: true\n",
        "version": "4.10.1"
      }
    ],
    "security": {
      "podSecurity": "baseline",
      "summary": "Watches K8up objects cluster-wide; backup Jobs mount PVCs in their own namespace."
    }
  },
