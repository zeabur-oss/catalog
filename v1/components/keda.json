        "name": "keda",
        "namespace": "keda",
        "profiles": {
          "multi-node": "operator:\n  # Leader-elected standby survives node drains.\n  replicaCount: 2\nresources:\n  # Room for a few hundred ScaledObjects.\n  operator:\n    requests: {cpu: 50m, memory: 128Mi}\n    limits: {memory: 512Mi}\n  metricServer:\n    requests: {cpu: 50m, memory: 96Mi}\n    limits: {memory: 512Mi}\n  webhooks:\n    requests: {cpu: 20m, memory: 48Mi}\n    limits: {memory: 256Mi}\n",
          "single-node": "resources:\n  # Chart defaults (100Mi/1000Mi) far exceed idle use.\n  operator:\n    requests: {cpu: 20m, memory: 64Mi}\n    limits: {memory: 256Mi}\n  metricServer:\n    requests: {cpu: 20m, memory: 48Mi}\n    limits: {memory: 256Mi}\n  webhooks:\n    requests: {cpu: 10m, memory: 32Mi}\n    limits: {memory: 128Mi}\n"
        },
        "repo": "https://kedacore.github.io/charts",
        "type": "helm",
        "values": "# Pinned by digest; a tag alone can move. An empty registry lets\n# repository hold the full name, which Renovate looks up.\nimage:\n  keda:\n    registry: \"\"\n    repository: ghcr.io/kedacore/keda\n    tag: 2.21.0@sha256:81fe6547ce8d1cc29273f887b76507e9b853e5bc1f875ec23fe60061a38ed809\n  metricsApiServer:\n    registry: \"\"\n    repository: ghcr.io/kedacore/keda-metrics-apiserver\n    tag: 2.21.0@sha256:255375037fe592732eeb554743aae360c2da88cf0b9b1258d0a987ef885f0881\n  webhooks:\n    registry: \"\"\n    repository: ghcr.io/kedacore/keda-admission-webhooks\n    tag: 2.21.0@sha256:e1969628cca6123e32eea13c47c75817091af2657fa68d9d0d58a8620d1b75b1\n",
        "version": "2.21.0"
      }
    ],
    "security": {
      "podSecurity": "restricted",
      "summary": "Reads scale targets and trigger secrets cluster-wide; serves the external metrics API."
    }
