                "name": "psmdb-operator",
                "requests": {
                  "cpu": "10m",
                  "memory": "64Mi"
                },
                "limits": {
                  "memory": "256Mi"
                }
              }
            ]
          }
        ],
        "persistentVolumeClaims": []
      }
    }
  },
