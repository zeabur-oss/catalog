    "releases": [
      {
        "chart": "oci://ghcr.io/victoriametrics/helm-charts/victoria-metrics-operator",
        "chartDigest": "sha256:1817be5446c975a306e404d6b605eafc45dbe6512a64d25b80d72f458fa4664a",
        "name": "operator",
        "namespace": "observability",
        "profiles": {
          "single-node": "resources:\n  # The operator idles near 54Mi.\n  requests: {cpu: 10m, memory: 72Mi}\n  limits: {memory: 256Mi}\nenv:\n  # The config reloaders it adds to vmagent, vmalert and Alertmanager idle near 12Mi; its default asks 25Mi each.\n  - {name: VM_CONFIG_RELOADER_REQUEST_MEMORY, value: 16Mi}\n"
        },
        "releaseName": "victoria-metrics-operator",
        "type": "helm",
        "values": "# Pinned by digest; a tag alone can move.\nimage:\n  repository: victoriametrics/operator\n  tag: v0.75.2@sha256:237fac68b608c7ed7bc4c47ad25ebcb1cbe973c9a789661d2b6cfaa83093f87a\n# The operator and the cleanup Job share this container context, which lacks a seccomp profile and runAsNonRoot; Pod Security restricted requires both.\nsecurityContext:\n  runAsNonRoot: true\n  runAsUser: 65534\n  seccompProfile: {type: RuntimeDefault}\nadmissionWebhooks:\n  certManager:\n    # cert-manager issues the webhook certificate, so every render is identical.\n    enabled: true\ncrds:\n  # Delete VM objects before uninstall so finalizers don't block the namespace.\n  cleanup:\n    enabled: true\n    # Pinned by digest; a tag alone can move. The chart's default tag\n    # follows the cluster's Kubernetes version.\n    image:\n      repository: registry.k8s.io/kubectl\n      tag: v1.36.0@sha256:63e5e76b746bb8b891a94968d380736c035e768dab0d56ddad1f50c750a4be39\n",
        "version": "0.68.1"
      }
    ],
    "requires": [
      {
        "capability": "certificates"
      }
    ],
    "security": {
      "podSecurity": "restricted",
      "summary": "Manages VictoriaMetrics and VictoriaLogs objects and their workloads in all namespaces. It can read every Secret, create pods in any namespace, and create ClusterRoles and bindings, so its token equals cluster-admin.\n"
    }
  },
